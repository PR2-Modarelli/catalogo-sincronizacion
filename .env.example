# Copiar a .env. No completar este archivo con secretos reales.
CATALOGO_JWT_SECRET=
CATALOGO_CATEDRA_BASE_URL=
CATALOGO_CATEDRA_TOKEN=
CATALOGO_DB_USER=catalogo
CATALOGO_DB_PASSWORD=

# Habilitar solo al completar los valores de integration.
CATALOGO_SYNC_ENABLED=false
CATALOGO_SYNC_INTERVAL_MS=60000
CATALOGO_REDIS_HOST=
CATALOGO_REDIS_PORT=6379
CATALOGO_REDIS_USERNAME=
CATALOGO_REDIS_PASSWORD=
CATALOGO_KAFKA_BOOTSTRAP_SERVERS=
CATALOGO_KAFKA_CATALOG_TOPIC=
CATALOGO_KAFKA_CONSUMER_GROUP=
# Desactivar las funciones de ejemplo de JHipster al usar la integracion real.
SPRING_CLOUD_STREAM_ENABLED=false
